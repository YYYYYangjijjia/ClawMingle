[Unit]
Description=ClawMingle local administration
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/.local/lib/clawmingle/admin
ExecStart=%h/.local/lib/clawmingle/admin-venv/bin/python -B %h/.local/lib/clawmingle/admin/clawmingle_admin.py --standalone --init --config %h/.config/clawmingle/social.toml --binary %h/.local/lib/clawmingle/clawmingle --assets %h/.local/lib/clawmingle/admin/assets --port 17430
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=true
MemoryMax=192M
TasksMax=64
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=default.target
